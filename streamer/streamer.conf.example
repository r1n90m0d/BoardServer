# streamer 설정 예시. "key = value", '#' 뒤는 주석.
# 적용: streamer -c /경로/streamer.conf   (명령행 -o key=value 가 우선)
# 아래 값은 모두 기본값이다.

iq_dir      = /oem/usr/share/iqfiles   # rkaiq IQ json 디렉토리
log_file    =                          # 비우면 stderr (-l 옵션과 같음)
rtsp_port   = 554

fps         = 18     # 실제 목표 fps (인코더 프레임레이트)
ae_fps_x10  = 120    # rkaiq AE 고정 fps x10 (센서 표기 기준). 실제 fps = 값/10 x 1.5
                     # 예: 120 -> 실제 18fps, 133 -> 실제 약 20fps, 0 -> 고정 안 함

raw_buf_cnt = 3      # CIF raw 버퍼 수
vi_buf_cnt  = 3      # 메인 VI 버퍼 수
vi_depth    = 1      # 메인 VI Depth

main_width  = 1920
main_height = 1080
main_kbps   = 4096   # CBR
main_gop    = 18     # 프레임 수 (18fps 에서 1초)

sub_enable     = 1    # 서브 스트림 /live/1
sub_vi_buf_cnt = 2
sub_vi_depth   = 0
sub_width      = 960
sub_height     = 540
sub_kbps       = 1024
sub_gop        = 18

osd_enable     = 1    # 날짜·시각 OSD (왼쪽 위)

stall_timeout_s  = 5       # CIF 또는 VENC0 프레임 수가 이 시간 동안 늘지 않으면 정지로 판정
stall_grace_s    = 15      # 시작·재초기화 직후 판정하지 않는 시간
stall_action     = reinit  # log: 기록만 / reinit: 파이프라인 해제 후 다시 초기화
reinit_max       = 3       # 정지 때 재초기화 시도 횟수 상한 (넘으면 state=failed)
reinit_timeout_s = 30      # 재초기화가 이 시간 안에 끝나지 않으면 state=failed
status_file      = /tmp/streamer.status

audio_enable     = 0       # 오디오 G.711A 8kHz mono. 보드에서 검증하지 않았음.
                           # 마이크가 연결돼 있는지 확인하기 전에는 켜지 말 것 (design.md 5절)
